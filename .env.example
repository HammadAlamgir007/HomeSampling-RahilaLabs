# .env.example - REFERENCE ONLY
# 
# This file is for reference only!
# All environment configurations are now built directly into docker.sh
# 
# Simply run:
#   ./docker.sh up development     # Development with hot reload
#   ./docker.sh up staging         # Staging environment
#   ./docker.sh up production --profile prod-with-nginx  # Production
#
# You can override any variable at command line:
#   export BACKEND_PORT=8000
#   ./docker.sh up development

# ============================================================================
# DEVELOPMENT (docker.sh up development)
# ============================================================================
# ENVIRONMENT=development
# BACKEND_PORT=5000
# FRONTEND_PORT=3000
# FLASK_ENV=development
# FLASK_DEBUG=1
# NODE_ENV=development
# DATABASE_URL=sqlite:///rahila_labs_dev.db
# BACKEND_VOLUME=./backend (hot reload)
# FRONTEND_VOLUME=./frontend (hot reload)
# BACKEND_COMMAND=flask run --host=0.0.0.0
# FRONTEND_COMMAND=npm run dev
# RESTART_POLICY=unless-stopped

# ============================================================================
# STAGING (docker.sh up staging)
# ============================================================================
# ENVIRONMENT=staging
# BACKEND_PORT=5000
# FRONTEND_PORT=3001
# FLASK_ENV=staging
# FLASK_DEBUG=0
# NODE_ENV=staging
# DATABASE_URL=sqlite:///rahila_labs_staging.db
# BACKEND_VOLUME=./backend
# FRONTEND_VOLUME=./frontend
# BACKEND_COMMAND=python run.py
# FRONTEND_COMMAND=node server.js
# RESTART_POLICY=always

# ============================================================================
# PRODUCTION (docker.sh up production --profile prod-with-nginx)
# ============================================================================
# ENVIRONMENT=production
# BACKEND_PORT=5000
# FRONTEND_PORT=3001
# FLASK_ENV=production
# FLASK_DEBUG=0
# NODE_ENV=production
# DATABASE_URL=sqlite:///rahila_labs.db (or PostgreSQL)
# BACKEND_VOLUME=/app (immutable)
# FRONTEND_VOLUME=/app (immutable)
# BACKEND_COMMAND=python run.py
# FRONTEND_COMMAND=node server.js
# RESTART_POLICY=always

# PRODUCTION SECRETS (set these before deployment!)
# PROD_JWT_SECRET_KEY=your-secret-key-here
# PROD_DATABASE_URL=postgresql://user:pass@host:5432/dbname
# PROD_API_URL=https://api.yourdomain.com
# PROD_DB_USER=production_user
# PROD_DB_PASSWORD=very-secure-password
# PROD_DB_HOST=db-host
# PROD_DB_PORT=5432
# PROD_DB_NAME=production_db
