# ==============================================================================
# Rahila Labs - Production Environment Variable Template
# ==============================================================================
# Copy this file to your secure vault or Azure Key Vault.
# Do NOT commit the actual values to version control.
# ==============================================================================

# ── 1. Application Settings ───────────────────────────────────────────────────
FLASK_APP=wsgi.py
FLASK_ENV=production
SECRET_KEY=<generate_a_secure_random_string>
JWT_SECRET_KEY=<generate_another_secure_random_string>

# ── 2. Database (Azure Database for MySQL) ──────────────────────────────────────
# Format: mysql+pymysql://<user>:<password>@<server>.mysql.database.azure.com/<db>
DATABASE_URL=<your_azure_mysql_connection_string>

# ── 3. Redis & Celery (Azure Cache for Redis) ─────────────────────────────────
# Format: rediss://:<password>@<redis-name>.redis.cache.windows.net:6380/0
REDIS_URL=<your_azure_redis_connection_string>
CELERY_BROKER_URL=<your_azure_redis_connection_string>
CELERY_RESULT_BACKEND=<your_azure_redis_connection_string>

# ── 4. Observability ──────────────────────────────────────────────────────────
# Sentry Data Source Name for error tracking
SENTRY_DSN=<your_sentry_dsn_url>

# ── 5. Email Configuration (SMTP) ─────────────────────────────────────────────
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=465
MAIL_USE_TLS=False
MAIL_USE_SSL=True
MAIL_USERNAME=<your_support_email@gmail.com>
MAIL_PASSWORD=<your_app_specific_password>
MAIL_DEFAULT_SENDER="Rahila Labs <support@rahilalabs.com>"

# ── 6. External Notifications (Optional) ──────────────────────────────────────
# Example: Twilio, MSG91, etc.
SMS_API_KEY=<your_sms_provider_api_key>
WHATSAPP_API_KEY=<your_whatsapp_provider_api_key>

# ── 7. Admin Defaults ─────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@rahilalabs.com
ADMIN_PASSWORD=<super_secure_admin_password>
