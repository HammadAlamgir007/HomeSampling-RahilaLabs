# ============================================================
# Docker Environment Variables
# ============================================================
# Copy this file to .env when using docker-compose
# docker-compose automatically reads from .env in the same dir
# ============================================================

# ── Backend Configuration ────────────────────────────────────
FLASK_ENV=development
SECRET_KEY=docker-dev-secret-key-2026
JWT_SECRET_KEY=docker-jwt-secret-key-2026
DEFAULT_ADMIN_PASSWORD=admin123
DEFAULT_DEMO_PASSWORD=demo123
DEFAULT_RIDER_PASSWORD=rider123

# ── Frontend Configuration ───────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:5000
NODE_ENV=production

# ── Optional: Email (for contact form) ───────────────────────
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASS=your-app-password
