# ============================================================
# Docker Environment Variables — TEMPLATE
# ============================================================
# Copy this file to .env when using docker-compose:
#   cp .env.docker .env
# Then replace the placeholder values with real secrets.
# NEVER commit the .env file to version control.
# ============================================================

# ── Backend Configuration ────────────────────────────────────
FLASK_ENV=development
SECRET_KEY=CHANGE-ME-generate-with-python-secrets-token_urlsafe-32
JWT_SECRET_KEY=CHANGE-ME-generate-with-python-secrets-token_urlsafe-32
DEFAULT_ADMIN_PASSWORD=CHANGE-ME-use-strong-password
DEFAULT_DEMO_PASSWORD=CHANGE-ME-use-strong-password
DEFAULT_RIDER_PASSWORD=CHANGE-ME-use-strong-password

# ── Frontend Configuration ───────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:5000
NODE_ENV=production

# ── Optional: Email (for contact form) ───────────────────────
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASS=your-app-password
